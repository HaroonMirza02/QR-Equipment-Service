# ─────────────────────────────────────────────────────────────────────────────
# QR Equipment Service — Environment Variables
# Copy this file to .env and fill in all values before starting the server.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
# Port the Express server will listen on.
PORT=3000

# Base URL used when constructing absolute QR code image URLs.
# In development this is typically http://localhost:3000.
# In production, set to your public domain (e.g. https://api.example.com).
BASE_URL=http://localhost:3000

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Full MongoDB connection string.
# Example (local):   mongodb://localhost:27017/qr_equipment
# Example (Atlas):   mongodb+srv://<user>:<pass>@cluster.mongodb.net/qr_equipment
MONGODB_URI=mongodb://localhost:27017/qr_equipment

# ── JWT ───────────────────────────────────────────────────────────────────────
# Secret used to sign and verify JWTs. Must be long and random.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret

# Token lifetime in seconds. Default: 86400 (24 hours).
JWT_EXPIRES_IN=86400

# ── bcrypt ────────────────────────────────────────────────────────────────────
# Number of bcrypt salt rounds. Minimum 12 per architecture spec.
BCRYPT_ROUNDS=12

# ── QR Storage ────────────────────────────────────────────────────────────────
# Directory (relative to project root) where generated QR PNG files are stored.
# This folder is served as static files at /static/qr/.
# Will be created automatically on first use.
QR_STORAGE_PATH=public/qr

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Max requests per minute per IP on the public scan endpoint.
PUBLIC_SCAN_RATE_LIMIT=60

# ── Node Environment ──────────────────────────────────────────────────────────
NODE_ENV=development
